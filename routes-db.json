            "name": "faker:person.fullName",
            "price": "number"
          }
        }
      }
    }
  },
  {
    "type": "typescript",
    "responseDataType": "detail",
    "mainConfig": {
      "types": {
        "User": {
          "return": "object",
          "itemType": {
            "id": "number",
            "fullName": "faker:person.fullName",
            "contacts": {
              "return": "array",
              "itemType": {
                "type": "home",
                "phone": "faker:phone.number"
              }
            }
          }
        }
      }
    },
    "responseTemplate": {
      "success": true,
      "result": "{{data}}"
    },
    "path": "/api/test-configfile",
    "method": "GET",
    "configFile": "test-config-v3.json"
  },
  {
    "path": "/api/test-backward",
    "method": "GET",
    "type": "ts-type",
