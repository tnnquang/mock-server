      "filePath": "src/test-types-internal.ts",
      "typeName": "AdminUser"
    }
  },
  {
    "type": "typescript",
    "responseDataType": "list",
    "mainConfig": {
      "types": {
        "Order": {
          "return": "array",
          "itemType": {
            "orderId": "number",
